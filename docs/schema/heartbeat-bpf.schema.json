{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dx-compass.local/schema/heartbeat-bpf.schema.json",
  "title": "DX-Compass 多波段 BPF 组 heartbeat（设备 → 服务端）",
  "description": "主题 bpf/device/{device_id}/heartbeat。band 为空串表示未插入任何滤波仓。规范见 §11.2。",
  "allOf": [
    { "$ref": "https://dx-compass.local/schema/common.schema.json#/$defs/heartbeat_envelope" }
  ],
  "properties": {
    "data": { "$ref": "#/$defs/data" }
  },
  "$defs": {
    "data": {
      "allOf": [
        { "$ref": "https://dx-compass.local/schema/common.schema.json#/$defs/data_common" }
      ],
      "required": [
        "device_class",
        "band",
        "mode",
        "bypass",
        "switching",
        "filter_bank",
        "rf_detected",
        "tx_active"
      ],
      "properties": {
        "device_class": { "const": "bpf" },
        "band": {
          "type": "string",
          "pattern": "^(\\d{1,3}m)?$"
        },
        "mode": {
          "type": "string",
          "enum": ["manual", "auto"]
        },
        "bypass": { "type": "boolean" },
        "switching": { "type": "boolean" },
        "filter_bank": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\d{1,3}m$"
          }
        },
        "rf_detected": { "type": "boolean" },
        "tx_active": { "type": "boolean" },
        "insertion_loss_db": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 10 },
            { "type": "null" }
          ]
        },
        "fault": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9-]*$"
        }
      },
      "additionalProperties": true
    }
  }
}
