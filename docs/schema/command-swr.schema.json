{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dx-compass.local/schema/command-swr.schema.json",
  "title": "DX-Compass 驻波表 json_command（服务端 → 设备）",
  "description": "唯一允许的远程动作是清峰值保持。校准/阈值写入一律禁止，设备应回 calibration-locked。规范见 §12.4。",
  "allOf": [
    { "$ref": "https://dx-compass.local/schema/common.schema.json#/$defs/command_envelope" }
  ],
  "properties": {
    "data": { "$ref": "#/$defs/data" }
  },
  "$defs": {
    "data": {
      "type": "object",
      "required": ["device_id", "action"],
      "properties": {
        "device_id": { "$ref": "https://dx-compass.local/schema/common.schema.json#/$defs/device_id" },
        "action": {
          "type": "string",
          "enum": ["clear_peak"]
        }
      },
      "additionalProperties": true
    }
  }
}
