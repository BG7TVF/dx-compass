{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dx-compass.local/schema/http-tx.schema.json",
  "title": "DX-Compass 发射状态上报（POST /api/devices/tx）",
  "description": "tx_active 必须是 JSON 布尔；seq 单调递增，回退帧被 200 ignored:stale-seq 丢弃。规范见 §10.3。",
  "type": "object",
  "required": ["source_id", "tx_active"],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "tx_active": { "type": "boolean" },
    "ts": {
      "anyOf": [
        { "type": "integer", "minimum": 0 },
        { "$ref": "https://dx-compass.local/schema/common.schema.json#/$defs/iso_ts" }
      ],
      "description": "毫秒 Unix 时间戳或 ISO 8601 UTC"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "token": {
      "type": "string",
      "maxLength": 200
    }
  },
  "additionalProperties": true
}
