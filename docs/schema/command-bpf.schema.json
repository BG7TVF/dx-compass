{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dx-compass.local/schema/command-bpf.schema.json",
  "title": "DX-Compass 多波段 BPF 组 json_command（服务端 → 设备）",
  "description": "band / bypass / action 三选一且只能选一个。band 必须在设备 supported_bands 内；发射中设备必须拒绝。规范见 §11.5。",
  "allOf": [
    { "$ref": "https://dx-compass.local/schema/common.schema.json#/$defs/command_envelope" }
  ],
  "properties": {
    "data": { "$ref": "#/$defs/data" }
  },
  "$defs": {
    "data": {
      "type": "object",
      "required": ["device_id"],
      "properties": {
        "device_id": { "$ref": "https://dx-compass.local/schema/common.schema.json#/$defs/device_id" },
        "band": {
          "type": "string",
          "pattern": "^\\d{1,3}m$"
        },
        "bypass": { "type": "boolean" },
        "action": {
          "type": "string",
          "enum": ["ack_alarms"]
        },
        "codes": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        }
      },
      "oneOf": [
        { "required": ["band"] },
        { "required": ["bypass"] },
        { "required": ["action"] }
      ],
      "allOf": [
        {
          "if": { "required": ["codes"] },
          "then": { "required": ["action"] }
        }
      ],
      "additionalProperties": true
    }
  }
}
