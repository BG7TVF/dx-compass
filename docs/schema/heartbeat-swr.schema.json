{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dx-compass.local/schema/heartbeat-swr.schema.json",
  "title": "DX-Compass 驻波表 heartbeat（设备 → 服务端）",
  "description": "主题 swr/device/{device_id}/heartbeat。swr 无 RF 时为 null；tx_active 是互锁输入，必须在 200/300 ms 内翻转。规范见 §12.2。",
  "allOf": [
    { "$ref": "https://dx-compass.local/schema/common.schema.json#/$defs/heartbeat_envelope" }
  ],
  "properties": {
    "data": { "$ref": "#/$defs/data" }
  },
  "$defs": {
    "data": {
      "allOf": [
        { "$ref": "https://dx-compass.local/schema/common.schema.json#/$defs/data_common" }
      ],
      "required": [
        "device_class",
        "fwd_power_w",
        "rev_power_w",
        "swr",
        "pep",
        "tx_active",
        "tx_threshold_w",
        "max_power_w",
        "cal_valid",
        "cal_locked"
      ],
      "properties": {
        "device_class": { "const": "swr" },
        "fwd_power_w": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 100000 },
            { "type": "null" }
          ]
        },
        "rev_power_w": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 100000 },
            { "type": "null" }
          ]
        },
        "swr": {
          "anyOf": [
            { "type": "number", "minimum": 1, "maximum": 99.99 },
            { "type": "null" }
          ]
        },
        "rl_db": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 40 },
            { "type": "null" }
          ]
        },
        "pep": { "type": "boolean" },
        "peak_fwd_w": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "freq_hz": {
          "anyOf": [
            { "type": "integer", "minimum": 0, "maximum": 1300000000 },
            { "type": "null" }
          ]
        },
        "band": {
          "type": "string",
          "pattern": "^(\\d{1,3}m)?$"
        },
        "tx_active": { "type": "boolean" },
        "tx_threshold_w": {
          "type": "number",
          "minimum": 1,
          "maximum": 10000
        },
        "sample_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_power_w": {
          "type": "number",
          "minimum": 1,
          "maximum": 100000
        },
        "cal_valid": { "type": "boolean" },
        "cal_locked": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  }
}
